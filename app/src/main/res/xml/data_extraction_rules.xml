<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for Android 12 and above.

    The coach configuration file holds the encrypted credential. It is excluded
    from both cloud backup and device-to-device transfer, so the credential is
    never restored onto another device or installation; the learner re-enters it
    while decks and progress are restored as usual.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="coach_configuration.enc" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="coach_configuration.enc" />
    </device-transfer>
</data-extraction-rules>
